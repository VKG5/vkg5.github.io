---
// Site-wide ambient particles — drifting copper dust motes on every page.
// Lightweight 2D canvas (no WebGL), theme-aware, reduced-motion aware,
// pauses when the tab is hidden.
---

<canvas id="ambient-particles" class="ambient-particles" aria-hidden="true"></canvas>

<script>
  function initAmbientParticles() {
    const canvas = document.getElementById('ambient-particles') as HTMLCanvasElement | null;
    if (!canvas) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) return; // No ambient animation for reduced motion

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let rafId = 0;

    const DPR = Math.min(window.devicePixelRatio || 1, 1.5);
    // Scale count with viewport size, capped for performance
    const COUNT = Math.max(30, Math.min(70, Math.floor(window.innerWidth / 22)));

    interface Particle {
      x: number;
      y: number;
      r: number;
      vx: number;
      vy: number;
      opacity: number;
      twinkleSpeed: number;
      twinklePhase: number;
    }

    let particles: Particle[] = [];

    function accentColor(): string {
      return (
        getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim() ||
        '#c97c45'
      );
    }

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = Math.floor(width * DPR);
      canvas!.height = Math.floor(height * DPR);
      canvas!.style.width = `${width}px`;
      canvas!.style.height = `${height}px`;
      ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);
    }

    function seed() {
      particles = Array.from({ length: COUNT }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: 0.6 + Math.random() * 1.6,
        vx: (Math.random() - 0.5) * 0.12,
        vy: -0.04 - Math.random() * 0.14, // gentle upward drift
        opacity: 0.12 + Math.random() * 0.3,
        twinkleSpeed: 0.4 + Math.random() * 1.2,
        twinklePhase: Math.random() * Math.PI * 2,
      }));
    }

    let startTime = performance.now();

    function draw(now: number) {
      rafId = requestAnimationFrame(draw);
      const t = (now - startTime) / 1000;
      const color = accentColor();

      ctx!.clearRect(0, 0, width, height);
      ctx!.fillStyle = color;

      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;

        // Wrap around edges
        if (p.y < -4) p.y = height + 4;
        if (p.x < -4) p.x = width + 4;
        if (p.x > width + 4) p.x = -4;

        // Gentle sway + twinkle
        const sway = Math.sin(t * 0.5 + p.twinklePhase) * 0.15;
        const twinkle = 0.65 + 0.35 * Math.sin(t * p.twinkleSpeed + p.twinklePhase);

        ctx!.globalAlpha = p.opacity * twinkle;
        ctx!.beginPath();
        ctx!.arc(p.x + sway, p.y, p.r, 0, Math.PI * 2);
        ctx!.fill();
      }

      ctx!.globalAlpha = 1;
    }

    resize();
    seed();

    window.addEventListener('resize', () => {
      resize();
      seed();
    });

    // Pause when the tab is hidden to save battery/CPU
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else {
        startTime = performance.now() - 0;
        rafId = requestAnimationFrame(draw);
      }
    });

    rafId = requestAnimationFrame(draw);

    // Cleanup for Astro view transitions
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(rafId);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAmbientParticles);
  } else {
    initAmbientParticles();
  }
</script>

<style>
  .ambient-particles {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    pointer-events: none;
  }
</style>