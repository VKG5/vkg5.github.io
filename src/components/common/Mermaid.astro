---
/**
 * Mermaid diagram for content that cannot use a ```mermaid fence (for example a
 * chart built from an expression). Rendering lives in MermaidRenderer.astro,
 * which BaseLayout mounts once per page.
 */
interface Props {
  chart: string;
  class?: string;
}

const { chart, class: className = '' } = Astro.props;
const diagramKey = `mermaid-${Math.random().toString(36).slice(2, 9)}`;
---

<div class={`mermaid-wrapper ${className}`.trim()} data-mermaid-id={diagramKey}>
  <pre class="mermaid" data-chart={chart}>{chart}</pre>
</div>

