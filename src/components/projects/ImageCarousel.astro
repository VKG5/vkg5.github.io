---

interface Props {
  images: { src: string; alt: string }[];
  cover?: string;
}

const { images, cover } = Astro.props;
const allImages = cover ? [{ src: cover, alt: 'Cover' }, ...images.filter((img) => img.src !== cover)] : images;
---

{allImages.length > 0 && (
  <div class="project-carousel tech-frame bg-bg-secondary overflow-hidden" data-carousel>
    <div class="carousel-track relative aspect-video">
      {allImages.map((img, index) => (
        <div class="carousel-slide absolute inset-0 transition-opacity duration-500" data-slide={index} data-active={index === 0 ? 'true' : 'false'}>
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-full object-cover"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}
    </div>

    {allImages.length > 1 && (
      <div class="flex items-center justify-between p-4 border-t border-border">
        <div class="flex items-center gap-2">
          {allImages.map((_, index) => (
            <button
              class="carousel-dot w-2 h-2 rounded-full bg-text-tertiary transition-colors"
              data-dot={index}
              aria-label={`Go to image ${index + 1}`}
            />
          ))}
        </div>
        <div class="flex items-center gap-2">
          <button class="carousel-prev btn btn-ghost px-3 py-1.5 text-xs" aria-label="Previous image">
            ← Prev
          </button>
          <span class="text-xs font-mono text-text-tertiary">
            <span data-current>1</span> / {allImages.length}
          </span>
          <button class="carousel-next btn btn-ghost px-3 py-1.5 text-xs" aria-label="Next image">
            Next →
          </button>
        </div>
      </div>
    )}
  </div>
)}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('[data-carousel]');

    carousels.forEach((carousel) => {
      const slides = carousel.querySelectorAll('[data-slide]');
      const dots = carousel.querySelectorAll('[data-dot]');
      const prevBtn = carousel.querySelector('.carousel-prev');
      const nextBtn = carousel.querySelector('.carousel-next');
      const currentLabel = carousel.querySelector('[data-current]');
      if (slides.length <= 1) return;

      let current = 0;

      function update(index: number) {
        current = index;
        slides.forEach((slide, i) => {
          const active = i === current;
          slide.setAttribute('data-active', String(active));
          (slide as HTMLElement).style.opacity = active ? '1' : '0';
          (slide as HTMLElement).style.zIndex = active ? '1' : '0';
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('bg-accent', i === current);
          dot.classList.toggle('bg-text-tertiary', i !== current);
        });
        if (currentLabel) currentLabel.textContent = String(current + 1);
      }

      function next() {
        update((current + 1) % slides.length);
      }

      function prev() {
        update((current - 1 + slides.length) % slides.length);
      }

      prevBtn?.addEventListener('click', prev);
      nextBtn?.addEventListener('click', next);
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => update(i));
      });

      // Keyboard navigation
      carousel.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'ArrowLeft') prev();
        if (keyEvent.key === 'ArrowRight') next();
      });
      (carousel as HTMLElement).setAttribute('tabindex', '0');

      update(0);
    });
  });
</script>