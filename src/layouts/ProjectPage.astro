---
import BaseLayout from './BaseLayout.astro';
import Tag from '@/components/common/Tag.astro';
import ImageCarousel from '@/components/projects/ImageCarousel.astro';
import { formatDate } from '@/lib/utils';
import { PROJECT_CATEGORIES } from '@/lib/constants';

interface Props {
  title: string;
  description: string;
  shortDescription?: string;
  publishedAt: Date;
  status: 'completed' | 'in-progress' | 'archived';
  categories?: string[];
  technologies: string[];
  order?: number;
  cover?: string;
  links?: {
    github?: string;
    demo?: string;
    download?: string;
  };
}

const {
  title,
  description,
  shortDescription,
  publishedAt,
  status,
  categories = [],
  technologies,
  order,
  cover,
  links,
} = Astro.props;

const categoryLabels = categories
  .map((slug) => PROJECT_CATEGORIES.find((c) => c.slug === slug)?.label ?? slug)
  .join(' / ');

const statusLabel =
  status === 'completed' ? 'Explored' : status === 'in-progress' ? 'In Progress' : 'Archived';

// Extract images from rendered content for the carousel
const contentHtml = await Astro.slots.render('default');
const imgRegex = /<img[^>]+src\s*=\s*"([^"]+)"[^>]*alt\s*=\s*"([^"]*)"[^>]*>/gi;
const extractedImages: { src: string; alt: string }[] = [];
let match;
while ((match = imgRegex.exec(contentHtml)) !== null) {
  extractedImages.push({ src: match[1], alt: match[2] || title });
}

// Remove images from inline content so they only appear in the carousel
const cleanedContent = contentHtml.replace(imgRegex, '');
---

<BaseLayout title={title} description={shortDescription ?? description} image={cover}>
  <article class="py-12 md:py-20">
    <!-- Field report header (§28) -->
    <header class="container mb-10">
      <div class="flex items-center gap-3 mb-5 flex-wrap">
        {order && <span class="frame-tag">PROJECT {String(order).padStart(2, '0')}</span>}
        <span class="text-border">/</span>
        <span class="frame-tag uppercase text-accent">{categoryLabels || 'Project'}</span>
        <span class="text-border">/</span>
        <span class="field-chip">{statusLabel}</span>
      </div>

      <h1 class="heading-1 mb-5">{title}</h1>

      <p class="lead mb-8 max-w-3xl">{shortDescription ?? description}</p>

      <!-- Technology -->
      <div class="flex flex-wrap gap-2 mb-8">
        {technologies.map((tech) => (
          <Tag>{tech}</Tag>
        ))}
      </div>

      <!-- Links — View Source is the primary action (§30) -->
      {links && (
        <div class="flex flex-wrap gap-4">
          {links.github && (
            <a href={links.github} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              View Source
            </a>
          )}
          {links.demo && (
            <a href={links.demo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              Live Demo
            </a>
          )}
          {links.download && (
            <a href={links.download} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Download
            </a>
          )}
        </div>
      )}
    </header>

    <!-- Image Carousel -->
    {(extractedImages.length > 0 || cover) && (
      <div class="container mb-12">
        <ImageCarousel images={extractedImages} cover={cover} />
      </div>
    )}

    <!-- Field report body -->
    <div class="container-narrow">
      <div class="prose-custom">
        <Fragment set:html={cleanedContent} />
      </div>
    </div>

    <!-- Footer -->
    <footer class="container-narrow mt-20 pt-8 border-t border-border">
      <div class="tech-frame p-8 md:p-10 bg-bg-secondary text-center">
        <span class="meta-label block mb-3">End of Report</span>
        <h3 class="heading-4 mb-4">Next artifact?</h3>
        <p class="text-text-secondary mb-6 max-w-lg mx-auto">
          More systems, tools, and experiments are documented on the work index — or reach out
          to discuss graphics, pipelines, and production technology.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/projects" class="btn btn-primary">← All Work</a>
          <a href="/contact" class="btn btn-ghost">Get in Touch</a>
        </div>
      </div>
      <p class="frame-tag mt-6 text-center">
        Documented {formatDate(publishedAt)}
      </p>
    </footer>
  </article>
</BaseLayout>