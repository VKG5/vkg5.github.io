---
import BaseLayout from './BaseLayout.astro';
import { formatDate, getReadingTime } from '@/lib/utils';
import Tag from '@/components/common/Tag.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  tags?: string[];
  cover?: string;
  headings: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  category,
  tags = [],
  cover,
  headings,
} = Astro.props;

const content = await Astro.slots.render('default');
const readingTime = getReadingTime(content);
---

<BaseLayout title={title} description={description} image={cover} article>
  <article class="py-12 md:py-20">
    <!-- Header -->
    <header class="container-narrow mb-12">
      <div class="flex items-center gap-3 text-sm text-text-tertiary mb-4">
        <a href={`/blog/category/${category}`} class="link capitalize">
          {category.replace('-', ' ')}
        </a>
        <span>·</span>
        <time datetime={publishedAt.toISOString()}>
          {formatDate(publishedAt)}
        </time>
        <span>·</span>
        <span>{readingTime} min read</span>
      </div>
      
      <h1 class="heading-1 mb-6">{title}</h1>
      
      <p class="lead mb-6">{description}</p>
      
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <Tag>{tag}</Tag>
          ))}
        </div>
      )}
      
      {updatedAt && (
        <p class="mt-6 text-sm text-text-tertiary">
          Last updated: {formatDate(updatedAt)}
        </p>
      )}
    </header>
    
    <!-- Cover image -->
    {cover && (
      <div class="container mb-12">
        <img
          src={cover}
          alt={title}
          class="w-full rounded-xl border border-border"
        />
      </div>
    )}
    
    <!-- Content with TOC -->
    <div class="container relative">
      <!-- Main content (centered) -->
      <div class="max-w-3xl mx-auto">
        <div class="prose-custom">
          <slot />
        </div>
      </div>
      
      <!-- Sidebar TOC (desktop, sticky) -->
      {headings.length > 0 && (
        <aside id="toc-sidebar" class="hidden xl:block fixed right-8 top-32 w-64 overflow-y-auto no-scrollbar pb-8 z-30 transition-all duration-200" style="max-height: calc(100vh - 10rem);">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </div>
    
    <!-- Smooth ending -->
    <div class="container-narrow mt-20 mb-12">
      <div class="tech-frame p-8 md:p-12 bg-bg-secondary text-center">
        <span class="meta-label block mb-3">Thanks for Reading</span>
        <h3 class="heading-4 mb-4">Found this useful?</h3>
        <p class="text-text-secondary mb-6 max-w-lg mx-auto">
          If you enjoyed this article, share it with others or explore more writing on procedural systems, tools, and graphics.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/blog" class="btn btn-primary">← Back to Blog</a>
          <a href="/contact" class="btn btn-ghost">Get in Touch</a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // Handle TOC sidebar positioning to avoid footer overlap
  function initTocPositioning() {
    const toc = document.getElementById('toc-sidebar') as HTMLElement | null;
    const footer = document.querySelector('footer.border-t') as HTMLElement | null;
    
    if (!toc || !footer) return;
    
    const tocElement = toc;
    const footerElement = footer;
    const topOffset = 128; // top-32 = 8rem = 128px
    const bottomPadding = 32; // Extra padding from footer
    
    function updateTocPosition() {
      const footerRect = footerElement.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      
      // Calculate available height
      // If footer is visible, limit the TOC height
      if (footerRect.top < viewportHeight) {
        const availableHeight = footerRect.top - topOffset - bottomPadding;
        tocElement.style.maxHeight = `${Math.max(availableHeight, 100)}px`;
      } else {
        // Footer not visible, use full available space
        tocElement.style.maxHeight = `calc(100vh - 10rem)`;
      }
    }
    
    // Run on scroll and resize
    window.addEventListener('scroll', updateTocPosition, { passive: true });
    window.addEventListener('resize', updateTocPosition, { passive: true });
    
    // Initial call
    updateTocPosition();
  }
  
  // Run when DOM is ready
  document.addEventListener('DOMContentLoaded', initTocPositioning);
  // Also run for Astro view transitions
  document.addEventListener('astro:page-load', initTocPositioning);

  // Active TOC heading highlighting
  function initTocHighlight() {
    const tocLinks = document.querySelectorAll('[data-toc-link]');
    const headings = document.querySelectorAll('article [id]');
    if (tocLinks.length === 0 || headings.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            tocLinks.forEach((link) => {
              const active = link.getAttribute('data-toc-link') === id;
              link.classList.toggle('text-accent', active);
              link.classList.toggle('border-accent', active);
              link.classList.toggle('text-text-tertiary', !active);
              link.classList.toggle('border-transparent', !active);
            });
          }
        });
      },
      {
        rootMargin: '-20% 0px -60% 0px',
        threshold: 0,
      }
    );

    headings.forEach((heading) => observer.observe(heading));

    // Smooth scroll for TOC links
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const id = link.getAttribute('data-toc-link');
        const target = document.getElementById(id || '');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${id}`);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initTocHighlight);
  document.addEventListener('astro:page-load', initTocHighlight);
</script>
