---
import BaseLayout from './BaseLayout.astro';
import { formatDate, getReadingTime } from '@/lib/utils';
import ContentsControl from '@/components/blog/ContentsControl.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  tags?: string[];
  cover?: string;
  headings: { depth: number; slug: string; text: string }[];
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  category,
  tags = [],
  cover,
  headings,
  prev,
  next,
} = Astro.props;

const content = await Astro.slots.render('default');
const readingTime = getReadingTime(content);
---

<BaseLayout title={title} description={description} image={cover} article>
  <article class="py-12 md:py-20">
    <!-- Reading progress (decorative only) -->
    <div class="reading-progress" aria-hidden="true"><div class="reading-progress-bar" id="reading-progress-bar"></div></div>

    <!-- Header -->
    <header class="reading-column mb-12">
      <div class="flex items-center gap-3 frame-tag mb-5">
        <a href={`/blog?category=${category}`} class="link uppercase">
          {category.replace(/-/g, ' ')}
        </a>
        <span>·</span>
        <time datetime={publishedAt.toISOString()}>
          {formatDate(publishedAt)}
        </time>
        <span>·</span>
        <span>{readingTime} min read</span>
      </div>
      
      <h1 class="heading-1 mb-6">{title}</h1>
      
      <p class="lead mb-6">{description}</p>
      
      {tags.length > 0 && (
        <p class="frame-tag uppercase">
          {tags.join(' / ')}
        </p>
      )}
      
      {updatedAt && (
        <p class="mt-6 text-sm text-text-tertiary">
          Last updated: {formatDate(updatedAt)}
        </p>
      )}
    </header>
    
    <!-- Cover image -->
    {cover && (
      <div class="reading-column-wide mb-12">
        <img
          src={cover}
          alt={title}
          class="w-full rounded-md border border-border"
        />
      </div>
    )}
    
    <!-- Wide reading column -->
    <div class="reading-column">
      <div class="prose-custom">
        <slot />
      </div>
    </div>
    
    <!-- On-demand Contents -->
    {headings.length > 0 && <ContentsControl headings={headings} />}
    
    <!-- End of Note -->
    <div class="reading-column mt-20 mb-12">
      <div class="border-t border-border pt-8">
        <span class="meta-label block mb-4">End of Note</span>
        <p class="text-text-secondary mb-6">
          More field notes on graphics, procedural systems, tools, and pipelines
          are filed in the archive.
        </p>
        <a href="/blog" class="link-underline text-accent text-sm">More field notes →</a>
      </div>

      {(prev || next) && (
        <nav class="mt-12 pt-8 border-t border-border grid sm:grid-cols-2 gap-8" aria-label="Adjacent field notes">
          {prev && (
            <a href={`/blog/${prev.slug}`} class="group">
              <div class="frame-tag mb-1">← Previous</div>
              <span class="font-display font-medium text-text-primary group-hover:text-accent transition-colors">
                {prev.title}
              </span>
            </a>
          )}
          {next && (
            <a href={`/blog/${next.slug}`} class="group sm:text-right sm:justify-self-end">
              <div class="frame-tag mb-1">Next →</div>
              <span class="font-display font-medium text-text-primary group-hover:text-accent transition-colors">
                {next.title}
              </span>
            </a>
          )}
        </nav>
      )}
    </div>
  </article>
</BaseLayout>

<script>
  // Subtle top reading-progress line. Decorative only — updates on scroll.
  function initReadingProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    function update() {
      const article = document.querySelector('article');
      if (!article || !bar) return;
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const done = total > 0 ? Math.min(Math.max(-rect.top / total, 0), 1) : 0;
      bar.style.transform = `scaleX(${done})`;
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }

  document.addEventListener('DOMContentLoaded', initReadingProgress);
  document.addEventListener('astro:page-load', initReadingProgress);
</script>
