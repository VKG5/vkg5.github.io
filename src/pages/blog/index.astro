---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getCollection } from 'astro:content';
import { sortByDate, filterDrafts } from '@/lib/utils';
import { BLOG_CATEGORIES, BLOG_SECTIONS } from '@/lib/constants';

// Get all posts
const allPosts = await getCollection('blog');
const allPostsFiltered = sortByDate(filterDrafts(allPosts));

// Posts for the general grid (those NOT in a section hub)
const generalPosts = allPostsFiltered.filter(p => !p.data.section);

// Get category from query (for filtering the general grid)
const currentCategory = Astro.url.searchParams.get('category');
const filteredGeneralPosts = currentCategory 
  ? generalPosts.filter((p) => p.data.category === currentCategory)
  : generalPosts;

---

<BaseLayout
  title="Field Notes"
  description="Technical field notes on graphics, rendering, Unreal Engine, procedural generation, tools, and pipelines."
>
  <section class="section">
    <div class="container">
      <!-- Header -->
      <header class="mb-12" data-animate>
        <span class="meta-label block mb-4">Field Notes</span>
        <h1 class="heading-1 mb-4">Notes from the workshop.</h1>
        <p class="lead max-w-2xl">
          Technical deep-dives and working notes on graphics, rendering,
          procedural systems, tools, and production pipelines.
        </p>
      </header>
      
      <!-- Category Filter -->
      <div class="mb-10 pb-6 border-b border-border overflow-x-auto no-scrollbar" data-animate>
        <div class="flex items-center gap-2 min-w-max">
          <button
            data-filter="all"
            class="filter-btn px-4 py-2 text-sm font-medium rounded-md transition-colors bg-accent text-bg-primary"
          >
            All
          </button>
          {BLOG_CATEGORIES.map((cat) => (
            <button
              data-filter={cat.slug}
              class="filter-btn px-4 py-2 text-sm font-medium rounded-lg transition-colors whitespace-nowrap text-text-secondary hover:text-text-primary hover:bg-bg-secondary"
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>
      

      <!-- Hub Sections -->
      <div class="mb-12 grid gap-6" data-animate>
        {BLOG_SECTIONS.map((section) => {
          const sectionPosts = allPostsFiltered.filter(p => p.data.section === section.slug);
          if (sectionPosts.length === 0) return null;

          return (
            <a 
              href={`/blog/${section.slug}`} 
              class="group tech-frame card-lift block p-8 bg-bg-secondary hover:bg-bg-tertiary transition-colors relative overflow-hidden"
            >
              <div class="relative z-10">
                <div class="flex items-center gap-2 mb-4">
                  <span class="frame-tag uppercase text-accent">Section</span>
                  <span class="text-border">·</span>
                  <span class="frame-tag uppercase">{section.label}</span>
                </div>
                <h2 class="heading-3 mb-2 group-hover:text-accent transition-colors">{section.label}</h2>
                <p class="text-text-secondary max-w-2xl mb-6">{section.description}</p>
                
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="frame-tag">{String(sectionPosts.length).padStart(2, '0')} ENTRY</span>
                  </div>
                  <span class="text-sm text-accent group-hover:translate-x-1 transition-transform font-medium">
                    Open series →
                  </span>
                </div>
              </div>
              
              <!-- Decorative background logo -->
              <img 
                src="/images/godot-logo.svg" 
                alt="" 
                class="absolute right-[-2%] top-[-5%] w-1/3 opacity-10 pointer-events-none select-none grayscale group-hover:opacity-20 transition-opacity" 
              />
            </a>
          );
        })}
      </div>
      
      <!-- Posts Grid -->

      <!-- Posts Grid -->
      {filteredGeneralPosts.length > 0 ? (
        <div id="posts-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {generalPosts.map((post, index) => (
            <div data-animate style={`animation-delay: ${index * 50}ms`} data-category={post.data.category} class="post-item">
              <PostCard
                title={post.data.title}
                description={post.data.description}
                publishedAt={post.data.publishedAt}
                category={post.data.category}
                tags={post.data.tags}
                href={`/blog/${post.slug}`}
                featured={post.data.featured}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="card text-center py-16">
          <h3 class="heading-4 mb-2">No notes here yet</h3>
          <p class="text-text-tertiary">
            {currentCategory 
              ? `Nothing filed under this category yet. Check back soon.`
              : `Field notes are being written. Stay tuned!`
            }
          </p>
        </div>
      )}
    </div>
  </section>
  
  <script>
    const filterButtons = document.querySelectorAll('.filter-btn');
    const postItems = document.querySelectorAll('.post-item');
    
    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        
        // Update button styles
        filterButtons.forEach(btn => {
          if (btn === button) {
            btn.classList.add('bg-accent', 'text-bg-primary');
            btn.classList.remove('text-text-secondary', 'hover:text-text-primary', 'hover:bg-bg-secondary');
          } else {
            btn.classList.remove('bg-accent', 'text-bg-primary');
            btn.classList.add('text-text-secondary', 'hover:text-text-primary', 'hover:bg-bg-secondary');
          }
        });
        
        // Filter posts
        postItems.forEach(item => {
          const category = item.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            (item as HTMLElement).style.display = 'block';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
