---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/common/Button.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import HeroScene from '@/components/three/HeroScene.astro';
import { getCollection } from 'astro:content';
import { sortByDate, filterDrafts } from '@/lib/utils';
import { CAREER_TIMELINE } from '@/lib/constants';

// All projects sorted by display order
const allProjects = await getCollection('projects');
const orderedProjects = allProjects.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  return orderA - orderB;
});

const selectedWork = orderedProjects.slice(0, 3);
const moreWork = orderedProjects.slice(3, 6);

// Latest field notes
const allPosts = await getCollection('blog');
const posts = sortByDate(filterDrafts(allPosts)).slice(0, 2);

// Domain sections (§34 / §35)
const domains = [
  {
    label: 'Graphics & Systems',
    description:
      'Experiments, tools, and systems exploring rendering, procedural generation, geometry, performance, and real-time graphics.',
    slugs: ['opengl-renderer', 'l-systems', 'f1-track-generator', 'ai-landscape-generator'],
  },
  {
    label: 'Production Technology',
    description:
      'Tools and pipelines built to solve practical problems in digital content production — from asset analysis to motion capture.',
    slugs: ['game-asset-profiler', 'qol-blender', 'blender-face-animation'],
  },
];
---

<BaseLayout>
  <!-- Hero — typography is the hero (§23/§24/§25) -->
  <section class="relative min-h-[88vh] flex items-center overflow-hidden border-b border-border">
    <div class="absolute inset-0 grid-bg opacity-25 pointer-events-none"></div>

    <!-- Interactive wireframe artifact — mouse-tracked, theme-aware -->
    <HeroScene class="opacity-70" />

    <div class="container relative z-10 py-20">
      <div class="grid lg:grid-cols-[1fr_auto] gap-12 items-center">
        <div class="max-w-3xl">
          <div class="flex items-center gap-4 mb-6" data-animate>
            <img
              src="/images/portrait.jpg"
              alt="Portrait of Varun Kumar Gupta"
              class="w-12 h-12 rounded-full object-cover border border-accent/60"
              style="filter: sepia(0.2) contrast(1.05) saturate(0.9);"
              loading="eager"
            />
            <span class="meta-label">VARUN KUMAR GUPTA</span>
          </div>

          <h1 class="heading-1 mb-6" data-animate style="animation-delay: 80ms">
            I build the tools<br />behind digital worlds.
          </h1>

          <p class="lead mb-8 max-w-xl" data-animate style="animation-delay: 160ms">
            Graphics Engineer & Unreal Engine Pipeline TD. I build graphics systems,
            tools, and pipelines for digital production.
          </p>

          <div class="flex flex-wrap items-center gap-4 mb-10" data-animate style="animation-delay: 240ms">
            <Button href="/projects" variant="primary">Explore Work</Button>
            <Button href="/blog" variant="ghost">Read Field Notes</Button>
          </div>

          <div class="flex flex-wrap items-center gap-3 frame-tag" data-animate style="animation-delay: 320ms">
            <span>FILM</span><span class="text-border">·</span>
            <span>ANIMATION</span><span class="text-border">·</span>
            <span>REAL-TIME</span><span class="text-border">·</span>
            <span>GRAPHICS</span>
          </div>
        </div>

        <!-- Small technical artifact card (§25) -->
        <div class="hidden lg:block" data-animate style="animation-delay: 400ms">
          <div class="tech-frame bg-bg-secondary p-5 w-64 select-none" aria-hidden="true">
            <div class="flex items-center justify-between mb-4">
              <span class="frame-tag"><strong>SHOT_042</strong></span>
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
            </div>
            <dl class="space-y-2 text-xs font-mono">
              <div class="flex justify-between">
                <dt class="text-text-tertiary">FRAME</dt>
                <dd id="hero-frame" class="text-text-primary">001284</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-text-tertiary">FPS</dt>
                <dd class="text-text-primary">24</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-text-tertiary">ENGINE</dt>
                <dd class="text-text-primary">UNREAL</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-text-tertiary">GPU</dt>
                <dd class="text-accent">READY</dd>
              </div>
            </dl>
            <div class="mt-4 h-1 bg-bg-tertiary rounded-full overflow-hidden">
              <div id="hero-progress" class="h-full bg-accent rounded-full" style="width: 62%"></div>
            </div>
            <div class="mt-3 flex justify-between frame-tag">
              <span>SEQ 07</span>
              <span>RENDER QUEUE</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Current Role strip -->
  <section class="border-b border-border bg-bg-secondary">
    <div class="container py-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3" data-animate>
        <div class="flex items-center gap-3">
          <span class="field-chip">Currently</span>
          <span class="text-text-primary font-medium">Brown Bag Films</span>
          <span class="text-text-tertiary">—</span>
          <span class="text-text-secondary">Unreal Engine Pipeline TD</span>
        </div>
        <span class="frame-tag">PRODUCTION TECHNOLOGY · FILM & ANIMATION</span>
      </div>
    </div>
  </section>

  <!-- Selected Work -->
  <section class="section">
    <div class="container">
      <div class="flex items-end justify-between mb-10">
        <div>
          <span class="meta-label block mb-2">SEQ 01</span>
          <h2 class="heading-3">Selected Work</h2>
        </div>
        <a href="/projects" class="link-underline text-text-secondary hover:text-text-primary text-sm whitespace-nowrap">
          View all work →
        </a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {selectedWork.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.shortDescription ?? project.data.description}
            categories={project.data.categories}
            technologies={project.data.technologies}
            status={project.data.status}
            cover={project.data.cover}
            order={project.data.order}
            href={`/projects/${project.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- More Work -->
  {moreWork.length > 0 && (
    <section class="section-sm border-y border-border bg-bg-secondary">
      <div class="container">
        <span class="meta-label block mb-6">More Work</span>
        <div class="divide-y divide-border border-t border-b border-border">
          {moreWork.map((project) => (
            <a
              href={`/projects/${project.slug}`}
              class="group flex flex-col md:flex-row md:items-center justify-between gap-2 py-5 hover:bg-bg-tertiary transition-colors px-2"
              data-animate
            >
              <div class="flex items-baseline gap-4">
                <span class="frame-tag w-8">{String(project.data.order ?? '').padStart(2, '0')}</span>
                <h3 class="text-lg font-display font-semibold text-text-primary group-hover:text-accent transition-colors">
                  {project.data.title}
                </h3>
              </div>
              <div class="flex items-center gap-4 pl-12 md:pl-0">
                <span class="text-sm text-text-tertiary hidden md:inline">
                  {(project.data.shortDescription ?? project.data.description).slice(0, 72)}…
                </span>
                <span class="text-text-tertiary group-hover:text-accent group-hover:translate-x-1 transition-all">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Engineering Approach — two domains -->
  <section class="section">
    <div class="container">
      <div class="mb-10" data-animate>
        <span class="meta-label block mb-2">Engineering Approach</span>
        <h2 class="heading-3">Two problems, one discipline.</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-border border border-border rounded-lg overflow-hidden">
        {domains.map((domain) => (
          <div class="bg-bg-primary p-8 md:p-10" data-animate>
            <h3 class="heading-4 mb-3">{domain.label}</h3>
            <p class="text-text-secondary text-sm leading-relaxed mb-6">{domain.description}</p>
            <ul class="space-y-2">
              {domain.slugs.map((slug) => {
                const project = orderedProjects.find((p) => p.slug === slug);
                if (!project) return null;
                return (
                  <li>
                    <a
                      href={`/projects/${slug}`}
                      class="group inline-flex items-center gap-2 text-sm text-text-secondary hover:text-accent transition-colors"
                    >
                      <span class="w-1 h-1 rounded-full bg-accent"></span>
                      {project.data.title}
                      <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Career -->
  <section class="section-sm border-t border-border bg-bg-secondary">
    <div class="container">
      <div class="mb-10" data-animate>
        <span class="meta-label block mb-2">Career</span>
        <h2 class="heading-3">From artist tools to the systems beneath them.</h2>
      </div>

      <ol class="relative max-w-3xl">
        {CAREER_TIMELINE.map((job, index) => (
          <li class="relative pl-8 pb-10 last:pb-0" data-animate style={`animation-delay: ${index * 100}ms`}>
            {/* Timeline marker */}
            <span
              class={`absolute left-0 top-1.5 w-2.5 h-2.5 rounded-full border-2 ${
                job.current ? 'bg-accent border-accent' : 'bg-bg-secondary border-border-hover'
              }`}
            >
            </span>
            {index < CAREER_TIMELINE.length - 1 && (
              <span class="absolute left-[4px] top-5 bottom-0 w-px bg-border"></span>
            )}

            <div class="frame-tag mb-1">{job.period}</div>
            <h3 class="text-lg font-display font-semibold text-text-primary">
              {job.company}
              {job.current && <span class="field-chip ml-3 align-middle">Current</span>}
            </h3>
            <p class="text-text-secondary text-sm mb-2">{job.role}</p>
            <div class="flex flex-wrap gap-x-3 gap-y-1">
              {job.focus.map((item) => (
                <span class="text-xs text-text-tertiary font-mono">{item}</span>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Field Notes preview -->
  <section class="section">
    <div class="container">
      <div class="flex items-end justify-between mb-10">
        <div>
          <span class="meta-label block mb-2">Field Notes</span>
          <h2 class="heading-3">Notes from the workshop.</h2>
        </div>
        <a href="/blog" class="link-underline text-text-secondary hover:text-text-primary text-sm whitespace-nowrap">
          All field notes →
        </a>
      </div>

      {posts.length > 0 ? (
        <div class="grid gap-4">
          {posts.map((post, index) => {
            const date = new Date(post.data.publishedAt);
            const formattedDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            return (
              <a
                href={`/blog/${post.slug}`}
                class="tech-frame group block p-6 bg-bg-secondary hover:bg-bg-tertiary transition-colors"
                data-animate
                style={`animation-delay: ${index * 100}ms`}
              >
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-2 frame-tag">
                      <span class="text-accent uppercase">{post.data.category.replace(/-/g, ' ')}</span>
                      <span>/</span>
                      <span>{formattedDate}</span>
                    </div>
                    <h3 class="text-xl font-display font-semibold text-text-primary group-hover:text-accent transition-colors">
                      {post.data.title}
                    </h3>
                  </div>
                  <span class="text-text-tertiary group-hover:text-accent group-hover:translate-x-1 transition-all">→</span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="tech-frame p-12 text-center bg-bg-secondary">
          <p class="text-text-tertiary">Field notes coming soon.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section-sm border-t border-border bg-bg-secondary">
    <div class="container text-center" data-animate>
      <span class="meta-label block mb-3">Contact</span>
      <h2 class="heading-3 mb-4">Building something that needs engineering?</h2>
      <p class="text-text-secondary mb-8 max-w-xl mx-auto">
        I'm always interested in graphics systems, pipeline problems, and production tooling.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href="/contact" variant="primary">Get in Touch</Button>
        <Button href="/about" variant="ghost">About Me</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Subtle artifact-card life: frame counter + progress drift.
  // Respects prefers-reduced-motion; purely decorative.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const frameEl = document.getElementById('hero-frame');
  const progressEl = document.getElementById('hero-progress');

  if (!reducedMotion && frameEl && progressEl) {
    let frame = 1284;
    let progress = 62;
    let direction = 1;

    setInterval(() => {
      frame += 1;
      frameEl.textContent = String(frame).padStart(6, '0');

      progress += direction * 0.15;
      if (progress >= 78) direction = -1;
      if (progress <= 55) direction = 1;
      progressEl.style.width = `${progress}%`;
    }, 120);
  }
</script>