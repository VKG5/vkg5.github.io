---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/common/Button.astro';
import HeroScene from '@/components/three/HeroScene.astro';
import { getCollection } from 'astro:content';
import { sortByDate, filterDrafts } from '@/lib/utils';

// Get latest posts
const allPosts = await getCollection('blog');
const posts = sortByDate(filterDrafts(allPosts)).slice(0, 3);

// Get featured projects
const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);

// Expertise areas
const expertise = [
  {
    title: 'Procedural Generation',
    description: 'Designing rule-driven systems that generate terrain, architecture, vegetation, and entire worlds at scale.',
    icon: '01',
  },
  {
    title: 'Tool Development',
    description: 'Building Blender add-ons, Unreal plugins, and pipeline scripts that remove friction and multiply artist output.',
    icon: '02',
  },
  {
    title: 'Technical Art',
    description: 'Bridging art and engineering through shaders, materials, rigs, and real-time rendering pipelines.',
    icon: '03',
  },
];
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden border-b border-border">
    <HeroScene class="opacity-60" />
    
    <!-- Workshop grid overlay -->
    <div class="absolute inset-0 grid-bg opacity-30 pointer-events-none"></div>
    
    <div class="container relative z-10">
      <div class="max-w-3xl">
        <div class="meta-label mb-6" data-animate>
          VARUN KUMAR GUPTA — TECHNICAL ARTIST
        </div>
        
        <h1 class="heading-1 mb-8" data-animate>
          Building the invisible infrastructure behind creative worlds.
        </h1>
        
        <p class="lead mb-10 max-w-2xl" data-animate>
          I build procedural systems, artist-facing tools, and real-time pipelines that turn impossible creative workflows into production-ready reality.
        </p>
        
        <div class="flex flex-wrap items-center gap-4 mb-12" data-animate>
          <Button href="/blog" variant="primary">Read Blog</Button>
          <Button href="/projects" variant="ghost">View Projects</Button>
        </div>
        
        <div class="flex flex-wrap items-center gap-8 text-sm text-text-tertiary font-mono" data-animate>
          <span>Rockstar Games</span>
          <span class="text-border">/</span>
          <span>EA @ Technicolor</span>
          <span class="text-border">/</span>
          <span>500+ Artist Tools Shipped</span>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Expertise Section -->
  <section class="section-sm bg-bg-secondary border-b border-border">
    <div class="container">
      <div class="grid md:grid-cols-3 gap-px bg-border border border-border rounded-xl overflow-hidden">
        {expertise.map((item, index) => (
          <div class="bg-bg-secondary p-8 md:p-10 group hover:bg-bg-tertiary transition-colors" data-animate style={`animation-delay: ${index * 100}ms`}>
            <div class="flex items-start justify-between mb-6">
              <span class="text-xs font-mono text-text-tertiary">{item.icon}</span>
              <span class="w-2 h-2 rounded-full bg-accent opacity-0 group-hover:opacity-100 transition-opacity"></span>
            </div>
            <h3 class="text-lg font-display font-semibold text-text-primary mb-3">{item.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Latest Articles -->
  <section class="section">
    <div class="container">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="meta-label block mb-2">Latest Writing</span>
          <h2 class="heading-3">Articles</h2>
        </div>
        <a href="/blog" class="link-underline text-text-secondary hover:text-text-primary text-sm">
          View All →
        </a>
      </div>
      
      {posts.length > 0 ? (
        <div class="grid gap-4">
          {posts.map((post, index) => {
            const date = new Date(post.data.publishedAt);
            const formattedDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            return (
              <a href={`/blog/${post.slug}`} class="tech-frame group block p-6 bg-bg-secondary hover:bg-bg-tertiary transition-colors" data-animate style={`animation-delay: ${index * 100}ms`}>
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-2 text-xs font-mono text-text-tertiary">
                      <span class="text-accent">{post.data.category.replace(/-/g, ' ')}</span>
                      <span>/</span>
                      <span>{formattedDate}</span>
                      {post.data.featured && (
                        <span class="px-2 py-0.5 rounded bg-accent/10 text-accent">FEATURED</span>
                      )}
                    </div>
                    <h3 class="text-xl font-display font-semibold text-text-primary group-hover:text-accent transition-colors">{post.data.title}</h3>
                  </div>
                  <span class="text-text-tertiary group-hover:text-accent transition-colors">→</span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="tech-frame p-12 text-center bg-bg-secondary">
          <p class="text-text-tertiary mb-4">No articles yet. Check back soon!</p>
          <p class="text-sm text-text-tertiary">
            In the meantime, explore my <a href="/projects" class="link">projects</a>.
          </p>
        </div>
      )}
    </div>
  </section>
  
  <!-- Featured Projects -->
  <section class="section bg-bg-secondary border-y border-border">
    <div class="container">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="meta-label block mb-2">Selected Work</span>
          <h2 class="heading-3">Projects</h2>
        </div>
        <a href="/projects" class="link-underline text-text-secondary hover:text-text-primary text-sm">
          All Projects →
        </a>
      </div>
      
      {featuredProjects.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredProjects.map((project, index) => {
            const date = new Date(project.data.publishedAt);
            const formattedDate = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            return (
               <a href={`/projects/${project.slug}`} class="tech-frame group block bg-bg-primary hover:bg-bg-tertiary transition-colors overflow-hidden hover-glow" data-animate style={`animation-delay: ${index * 100}ms`}>
                <div class="aspect-video bg-bg-tertiary border-b border-border flex items-center justify-center overflow-hidden">
                  {project.data.cover ? (
                    <img src={project.data.cover} alt={project.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                  ) : (
                    <span class="text-4xl font-mono text-text-tertiary group-hover:text-accent transition-colors">◈</span>
                  )}
                </div>
                <div class="p-6">
                  <div class="flex items-center justify-between mb-3 text-xs font-mono text-text-tertiary">
                    <span class="text-accent">{project.data.category?.replace(/-/g, ' ') || 'Project'}</span>
                    <span>{formattedDate}</span>
                  </div>
                  <h3 class="text-lg font-display font-semibold text-text-primary group-hover:text-accent transition-colors mb-4">{project.data.title}</h3>
                  <div class="flex flex-wrap gap-2">
                    {project.data.technologies.slice(0, 3).map((tech) => (
                      <span class="tag">{tech}</span>
                    ))}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="tech-frame p-12 text-center bg-bg-primary">
          <p class="text-text-tertiary">Projects coming soon!</p>
        </div>
      )}
    </div>
  </section>
  
  <!-- About Preview -->
  <section class="section">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="tech-frame p-8 md:p-12 bg-bg-secondary" data-animate>
          <div class="flex flex-col md:flex-row items-start gap-8">
            <div class="w-24 h-24 tech-frame flex-shrink-0 flex items-center justify-center bg-bg-tertiary">
              <span class="text-3xl text-accent">◉</span>
            </div>
            
            <div>
              <span class="meta-label block mb-2">About</span>
              <h2 class="heading-4 mb-4">Hi, I'm Varun.</h2>
              <p class="text-text-secondary mb-4">
                I'm a Graphics Engineer and Technical Artist working on procedural generation, 
                real-time systems, and the pipelines that keep creative teams moving fast.
                I build the behind-the-scenes tech that turns ideas into scalable workflows 
                and empowers creative teams.
              </p>
              <p class="text-text-secondary mb-6">
                I'm deep into tool development, procedural systems, and experimenting 
                with new ways to generate landscapes, assets, and entire worlds through code.
              </p>
              <Button href="/about" variant="ghost">More About Me →</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>