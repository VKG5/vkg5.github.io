---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/common/Button.astro';
import Tag from '@/components/common/Tag.astro';
import { SOCIAL_LINKS, TECHNOLOGIES } from '@/lib/constants';

const experience = [
  {
    company: 'Zitro',
    role: 'Technical Artist',
    period: '2025 - Present',
    description:
      'Developed tools, pipelines, and GPU-optimized shaders for a custom Godot 3.5.2 build. Built automation systems, asset processors, localization workflows, and editor tools that streamline content creation from Blender, Spine, and Photoshop into the engine.',
  },
  {
    company: 'Upwork',
    role: 'Technical Artist (Freelance)',
    period: '2021 - Present',
    description:
      'Delivered tools and pipelines for various clients: Blender animation tools, Maya export pipelines, Unreal Engine puppeteering systems, and gameplay prototyping. Built C++ and Python tools used in production across multiple indie teams.',
  },
  {
    company: 'Trinity Walton Club, Trinity College Dublin',
    role: 'Course Author & Educator',
    period: '2024 - 2025',
    description:
      'Designed and taught game development, Python programming, and Blender courses for young learners. Built full curricula, teaching materials, prototypes, and hands-on STEM content focusing on logic, animation, physics, and scripting.',
  },
  {
    company: 'Technicolor Games',
    role: 'Junior Technical Artist',
    period: '2022 - 2023',
    clients: ['Rockstar Games', 'Electronic Arts'],
    description:
      'Worked on Procedural Content Generation, tools, and technical art pipelines across Unreal, Maya, and Blender. Delivered R&D, troubleshooting, workflow automation, and knowledge transfer for large art teams. Awarded the Eureka Award for innovation.',
  },
  {
    company: 'Sanmati Enterprises',
    role: '3D Generalist / 3D Modeller (Intern)',
    period: '2021',
    description:
      'Created optimized 3D models, established export pipelines for Unity/Unreal, and developed Blender Python scripts for animation tasks. Worked on VR/AR-ready assets and hard-surface modelling.',
  },
  {
    company: 'Gametathya',
    role: 'Game Dev & Asset Design Lead',
    period: '2020',
    description:
      'Led a team of programmers and artists to build a third-person shooter demo using Unreal Engine and C++. Responsible for gameplay design, core mechanics, and asset workflows.',
  },
  {
    company: 'ACM Student Chapter (Bennett University)',
    role: 'Creative Head / Treasurer',
    period: '2019 - 2020',
    description:
      'Managed creative projects, events, and team operations. Produced learning content, handled chapter fundraising, and led teams of 7–20 members.',
  },
];

const education = [
  {
    institution: 'Trinity College Dublin',
    degree: 'MSc, Computer Science — Augmented & Virtual Reality',
    period: '2023 – 2024',
    grade: 'Distinction',
    description:
      'Focused on real-time graphics, rendering, animation systems, machine learning, computer vision, and simulation. Strengths include GPU programming, real-time rendering, procedural systems, and graphics engineering.',
    topics: [
      'Computer Graphics',
      'Real-Time Rendering',
      'Machine Learning',
      'Computer Vision',
      'Real-Time Animation',
      'Augmented & Virtual Reality',
      'Mathematics of Light & Sound',
      'Motion Picture Engineering',
    ],
  },
  {
    institution: 'Bennett University',
    degree: 'BTech, Computer Science',
    period: '2018 – 2022',
    grade: '9.28 CGPA',
    description:
      'Built a strong foundation in programming, algorithms, game development, and 3D workflows. Gained experience in procedural generation, 3D modelling, and systems-level engineering.',
    topics: [
      'Data Structures & Algorithms',
      'Object-Oriented Programming',
      'Game Development',
      'Procedural Content Generation',
      '3D Modelling & Texturing',
      'Database Systems',
    ],
  },
];

const highlights = [
  {
    metric: '5+',
    label: 'Years with 3D Software',
    sublabel: 'Blender, Houdini, Unreal Engine',
  },
  {
    metric: '200+',
    label: 'Students Taught',
    sublabel: 'Python, Game Dev, Blender at Trinity College Dublin',
  },
  {
    metric: '2',
    label: 'Books Published',
    sublabel: 'Technical Reviewer & Contributor',
  },
];
---

<BaseLayout
  title="About"
  description="Technical Artist and Game Developer specializing in procedural generation, tool development, and pipeline optimization."
>
  <section class="section">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <header class="mb-12" data-animate>
          <span class="meta-label block mb-4">Profile</span>
          <h1 class="heading-1 mb-6">About</h1>
          <p class="lead">
            I'm Varun Kumar Gupta, aka Lumi, a Graphics Engineer and Technical Artist who enjoys building 
            the systems and pipelines that make creative work easier and faster. Most of my time goes into 
            procedural generation, real-time graphics, and writing tools that help artists get ideas on 
            screen without fighting the software.
          </p>
        </header>

        <!-- Main content -->
        <div class="tech-frame p-6 md:p-10 bg-bg-secondary prose-custom mb-12" data-animate>
          <p>
            I focus on the engineering side of worldbuilding: procedural generation, real-time graphics, and tool development. 
            Whether it's terrain synthesis, automated asset workflows, custom renderers, or data-driven pipelines, 
            I'm driven by one question: <em>How can code make creativity more efficient?</em>
          </p>
          
          <h2 class="heading-hover">What I Do</h2>
          
          <ul>
            <li>
              <strong>Procedural Content Generation (PCG)</strong> : I work on rule-based systems for environments, assets, 
              and worldbuilding. If something can be defined logically, I like figuring out how to make it generate itself.
            </li>
            <li>
              <strong>Tool Development</strong> : C++, Python, Unreal, Blender; I build tools that remove repetitive work 
              and let artists focus on the fun parts. Recently, I've been exploring lightweight AI-assisted workflows, 
              but always with the same rule: Artists first, AI later.
            </li>
            <li>
              <strong>Technical Art</strong> : Bridging art and engineering: Shaders, materials, rigging logic, rendering 
              quirks; basically the technical glue between code and visuals.
            </li>
          </ul>
          
          <h2 class="heading-hover">Technical Foundation</h2>
          
          <p>
            Right now my work revolves around <strong>C++, Python, Unreal Engine, Blender, Houdini, and graphics programming.</strong>
            OpenGL, Vulkan, HLSL, and compute-driven techniques. I'm especially interested in GPU-heavy systems 
            and <strong>real-time procedural workflows.</strong>
          </p>

          <p>
          I completed my <strong>Master's</strong> in <strong>Computer Science (Augmented & Virtual Reality)</strong> from <strong>Trinity College Dublin</strong>, 
          which pushed me deeper into rendering, simulation, and experimental graphics.
          </p>

          <p>
          Some of the things I've been working on recently:
          </p>

          <ul>
            <li> 
              <strong>Procedural landscape generation</strong> using AI paired with a custom <strong>C++ OpenGL renderer</strong>.
            </li>
            <li>
              <strong>Blender and Unreal tools</strong> focused on speeding up everyday artist workflows.
            </li>
            <li>
              <strong>GPU-based procedural experiments</strong> for environments, scattering systems, and rule-driven worldbuilding.
            </li>
          </ul>

          <p>
            This is the direction I'm moving toward — more engineering, more systems work, and a lot more experimentation.
          </p>

          <h2 class="heading-hover">Why I Write</h2>
          
          <p>
            I read a lot. Books, papers, weird technical blogs hidden on page 31415926 of Google, and I've always felt that 
            good learning material for PCG resources; especially for Blender, Unreal, and GPU workflows, are still scattered, 
            shallow, and surprisingly hard to find.
          </p>
          
          <p>So I write to fix that.</p>
          <p>My goal isn't quantity, it's clarity.</p>
          
          <p>
            Every article I publish aims to be practical, technical, and focused: the kind of content I wish existed when I was learning.
          </p>
          
          <p>
            I write to share what I'm building, what I'm studying, and the exact knowledge that pushes the field forward. One well-explained concept at a time.
          </p>
          
          <p>
            If you're exploring similar ideas or building something procedural, feel free to reach out. 
            I'm always happy to talk systems, tools, and worlds built by code.
          </p>
        </div>
        
        <!-- Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-border border border-border rounded-xl overflow-hidden mb-12" data-animate>
          {highlights.map((item) => (
            <div class="bg-bg-secondary p-6 md:p-8 text-center tech-frame hover-glow">
              <div class="text-3xl md:text-4xl font-bold text-text-primary mb-1">
                {item.metric}
              </div>
              <div class="text-sm text-text-secondary">{item.label}</div>
              <div class="text-xs text-text-tertiary">{item.sublabel}</div>
            </div>
          ))}
        </div>
        
        <!-- Skills -->
        <div class="tech-frame p-6 md:p-8 bg-bg-secondary mb-12" data-animate>
          <span class="meta-label block mb-4">Technologies</span>
          <div class="flex flex-wrap gap-2">
            {TECHNOLOGIES.map((tech) => (
              <Tag>{tech}</Tag>
            ))}
          </div>
        </div>
        
        <!-- Experience -->
        <div class="mb-12" data-animate>
          <span class="meta-label block mb-6">Experience</span>
          <div class="space-y-6">
            {experience.map((job) => (
              <div class="tech-frame p-6 bg-bg-secondary hover-glow transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                  <div class="sm:w-36 flex-shrink-0">
                    <span class="text-sm font-mono text-text-tertiary block">{job.period}</span>
                    <span class="w-2 h-2 rounded-full bg-accent mt-2 inline-block"></span>
                  </div>
                  <div>
                    <h4 class="font-display font-semibold text-text-primary text-lg mb-1">{job.role}</h4>
                    <p class="text-text-secondary mb-1">{job.company}</p>
                    {job.clients && (
                      <p class="text-sm text-text-tertiary mb-2">
                        Clients: {job.clients.join(', ')}
                      </p>
                    )}
                    <p class="text-sm text-text-secondary leading-relaxed">{job.description}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Education -->
        <div class="mb-12" data-animate>
          <span class="meta-label block mb-6">Education</span>
          <div class="space-y-6">
            {education.map((edu) => (
              <div class="tech-frame p-6 bg-bg-secondary hover-glow">
                <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                  <div class="sm:w-36 flex-shrink-0">
                    <span class="text-sm font-mono text-text-tertiary block">{edu.period}</span>
                    <span class="w-2 h-2 rounded-full bg-accent mt-2 inline-block"></span>
                  </div>
                  <div>
                    <h4 class="font-display font-semibold text-text-primary text-lg mb-1">{edu.degree}</h4>
                    <p class="text-text-secondary mb-1">{edu.institution}</p>
                    <p class="text-sm text-text-tertiary mb-3">
                      Grade: {edu.grade}
                    </p>
                    <p class="text-sm text-text-secondary mb-4 leading-relaxed">{edu.description}</p>
                    {edu.topics && (
                      <div class="flex flex-wrap gap-2">
                        {edu.topics.map((topic) => (
                          <Tag>{topic}</Tag>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- CTA -->
        <div class="tech-frame p-8 md:p-12 bg-bg-secondary text-center" data-animate>
          <span class="meta-label block mb-3">Let's Connect</span>
          <h3 class="heading-4 mb-4">Want to build something together?</h3>
          <p class="text-text-secondary mb-6 max-w-xl mx-auto">
            Have a project in mind or just want to chat about tech art, procedural systems, or graphics engineering?
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <Button href="/contact" variant="primary">Get in Touch</Button>
            <Button href={SOCIAL_LINKS.github} variant="ghost">
              GitHub →
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>